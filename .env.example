# Copy to .env and fill in. Never commit .env.

# --- Telegram ---
# Token from @BotFather
TELEGRAM_TOKEN=
# Your numeric Telegram user ID (admin who approves access), e.g. from @userinfobot
ADMIN_TELEGRAM_ID=

# --- Deye Cloud ---
# official = Deye OpenAPI (needs AppID/AppSecret), unofficial = Deye Cloud app API
DEYE_SOURCE=official
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0
DEYE_APP_ID=
DEYE_APP_SECRET=
# Deye Cloud account login
DEYE_EMAIL=
DEYE_PASSWORD=
# Optional: auto-detected if empty
DEYE_STATION_ID=
DEYE_DEVICE_SN=

# --- Behaviour (defaults shown) ---
# Fallback poll interval; normally the bot polls right after each logger frame (~3 min)
POLL_INTERVAL_SEC=60
STALE_AFTER_MIN=15
BATTERY_RESERVE_PCT=10
BATTERY_CAPACITY_KWH=24
BATTERY_THRESHOLDS=50,30,20,10
# Rated cycle life, for the wear estimate on /battery (500..20000)
BATTERY_RATED_CYCLES=6000
GRID_OFF_VOLTS=50
GRID_OK_VOLTS=180
# Owner alerts
BATTERY_TEMP_MAX_C=45
INVERTER_TEMP_MAX_C=70
CLOUD_DOWN_AFTER_MIN=10
# Admin alert and red zone when grid draw reaches this, kW (main breaker ~8 kW)
GRID_LOAD_MAX_KW=7
# Tariff, ₴/kWh (TARIFF_NIGHT=none for single-zone); night mode hours
TARIFF_DAY=4.32
TARIFF_NIGHT=2.16
TARIFF_NIGHT_FROM=23
TARIFF_NIGHT_TO=7
QUIET_FROM=23
QUIET_TO=7
# All of the above are defaults: the owner can change them in the bot (/settings → ⚙️ Настройки бота).
TZ_NAME=Europe/Kyiv

# --- Storage ---
DB_PATH=./data/deye.db

# --- Watchdog (optional, see worker/README.md) ---
WATCHDOG_URL=
WATCHDOG_SECRET=
